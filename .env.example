# Valeurs locales de démonstration uniquement. Copier vers .env et modifier les secrets.
SPRING_PROFILES_ACTIVE=dev
PORT=8080
POSTGRES_DB=vite_et_gourmand
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/vite_et_gourmand
MONGODB_DATABASE=vite_et_gourmand_statistics
MONGODB_PORT=27017
MONGODB_URI=mongodb://localhost:27017/vite_et_gourmand_statistics
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_UI_PORT=8025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
MAIL_FROM=no-reply@vite-gourmand.example
CONTACT_EMAIL=contact@vite-gourmand.example
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
API_URL=http://localhost:8080/api/v1
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_EMAIL=admin.local@example.test
INITIAL_ADMIN_PASSWORD=<mot-de-passe-fort-a-fournir-localement>
INITIAL_ADMIN_FIRST_NAME=Admin
INITIAL_ADMIN_LAST_NAME=Local
